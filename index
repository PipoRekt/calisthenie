[['Curl biceps élastique',12,'r','Élastique sous les pieds, coudes collés au corps.','curl'],['Curl biceps élastique lent',12,'r','Montée 1 s, descente 3 s.','curl'],['Curl biceps élastique, pause en haut',10,'r','Tiens 2 s en haut.','curl']]],
bpush:[
[['Pompes, élastique léger dans le dos',8,'r','Élastique passé dans le dos et sous les mains.','pu'],['Pompes, élastique dans le dos',10,'r','Élastique passé dans le dos et sous les mains.','pu'],['Pompes, élastique épais dans le dos',10,'r','Élastique épais, pousse jusqu\'en haut.','pu']],
[['Développé épaules élastique',12,'r','Élastique sous les pieds, pousse au-dessus de la tête.','ohp'],['Développé épaules élastique lent',12,'r','Descente en 3 s.','ohp'],['Développé épaules élastique, pause en haut',10,'r','Tiens 2 s bras tendus.','ohp']]],
blegs:[
[['Squats, élastique au-dessus des genoux',15,'r','Pousse les genoux vers l\'extérieur contre l\'élastique.','squat'],['Squats élastique tempo (3 s)',12,'r','Descends en 3 s, genoux ouverts.','squat'],['Squats élastique, pause 3 s',10,'r','Tiens 3 s en bas, genoux ouverts.','squat']],
[['Pont fessier, élastique au-dessus des genoux',15,'r','Écarte les genoux contre l\'élastique.','bridge'],['Pont fessier élastique, pause 2 s',12,'r','Tiens 2 s en haut.','bridge'],['Pont fessier élastique, lent',12,'r','Montée 1 s, descente 3 s.','bridge']]],
mob:[
[['Chat-vache',40,'t','Dos rond puis creux, au rythme du souffle.','catcow'],['Chat-vache lent',45,'t','Amplitude maximale, 5 s par mouvement.','catcow'],['Chat-vache, 5 s à chaque bout',50,'t','Tiens 5 s dos rond puis 5 s dos creux.','catcow']],
[['Rotations thoraciques',40,'t','À quatre pattes, main derrière la nuque, 20 s par côté.','thoracic'],['Rotations thoraciques lentes',45,'t','Ouvre le coude vers le plafond, 20 s par côté.','thoracic'],['Rotations thoraciques, pause en haut',50,'t','Tiens 3 s ouvert, 25 s par côté.','thoracic']],
[['Cercles de hanches debout',40,'t','Grands cercles lents, 20 s dans chaque sens.','hipcircles'],['Cercles de hanches debout, grande amplitude',45,'t','Les plus grands cercles possibles, 20 s par sens.','hipcircles'],['Cercles de hanche à quatre pattes',50,'t','Genou plié, grands cercles, 25 s par jambe.','donkey']],
[['Squat profond, mains au sol',30,'t','Accroupi, mains au sol pour t\'équilibrer, talons posés si possible.','squat'],['Squat profond tenu',40,'t','Coudes qui poussent les genoux vers l\'extérieur, dos droit.','squat'],['Squat profond tenu, mains jointes',45,'t','Mains jointes devant la poitrine, coudes dans les genoux.','sumo']],
[['Fente basse tenue (20 s par côté)',40,'t','Genou arrière au sol, hanches vers l\'avant.','lunge'],['Fente basse tenue (25 s par côté)',50,'t','Bassin enroulé, serre le fessier de la jambe arrière.','lunge'],['Fente basse, bras en l\'air (25 s par côté)',50,'t','Bras tendus au-dessus de la tête, hanches vers l\'avant.','lunge']],
[['Cobra',30,'t','Hanches au sol, ouvre la poitrine.','cobra'],['Cobra, coudes tendus',40,'t','Pousse sur les mains, épaules loin des oreilles.','cobra'],['Cobra, pause et respiration',45,'t','Respire profondément, ouvre les côtes.','cobra']],
[['Posture de l\'enfant',30,'t','Bras loin devant, respire profondément.','child'],['Posture de l\'enfant, bras longs',40,'t','Repousse les mains loin devant, fesses sur les talons.','child'],['Posture de l\'enfant, bras sur le côté',45,'t','Marche les mains d\'un côté puis de l\'autre.','child']],
[['Fessier allongé (20 s par côté)',40,'t','Ramène un genou vers l\'épaule opposée.','glute'],['Fessier allongé, tenue longue (25 s par côté)',50,'t','Reste détendu, respire dans l\'étirement.','glute'],['Genoux contre la poitrine',40,'t','Allongé, serre les genoux contre toi, nuque relâchée.','kneechest']],
[['Bird dog lent',40,'t','Étire bras et jambe au maximum, bassin stable.','bird'],['Bird dog, pause 3 s',45,'t','Tiens 3 s en extension, sans cambrer.','bird'],['Bird dog, coude-genou',50,'t','Ramène coude et genou sous le ventre, puis étends.','bird']],
[['Mobilité des poignets (quatre pattes)',30,'t','Paumes puis dos des mains au sol, balance doucement.','catcow'],['Mobilité des poignets, balancier',40,'t','Balance d\'avant en arrière, doigts vers toi puis vers l\'avant.','catcow'],['Mobilité des poignets, lente',45,'t','Petits cercles avec les poignets, mains posées.','catcow']]],
bmob:[
[['Passages d\'élastique (épaules)',10,'r','Élastique tenu large, passe-le devant puis derrière, bras tendus.','pass'],['Passages d\'élastique, prise plus étroite',12,'r','Rapproche les mains peu à peu.','pass'],['Passages d\'élastique, lents',12,'r','5 s par passage, amplitude complète.','pass']]],
rmob:[
[['Suspension passive',20,'t','Pends-toi, épaules relâchées, laisse la colonne s\'étirer.','hang'],['Suspension passive, longue',30,'t','Respire lentement, relâche les épaules.','hang'],['Suspension passive, 40 s',40,'t','Respire lentement, relâche les épaules.','hang']]],
back:[
[['Superman',12,'r','Soulève bras et jambes, nuque neutre.','superman'],['Superman, pause 3 s',10,'r','Tiens 3 s en haut.','superman'],['Superman, pause 5 s',8,'r','Tiens 5 s en haut, serre les omoplates.','superman']],
[['Reverse snow angel',12,'r','Sur le ventre, bras en arc de cercle.','snowangel'],['Reverse snow angel lent',12,'r','Bras tendus, arc très lent.','snowangel'],['Reverse snow angel, pause en haut',10,'r','Tiens 2 s bras le long du corps.','snowangel']]]
};
const W=[['Cercles de bras',30,'t','Grands cercles, avant puis arrière.','armcircles'],['Chat-vache',30,'t','Dos rond puis creux, au rythme du souffle.','catcow'],['Rotations thoraciques',30,'t','À quatre pattes, main derrière la nuque.','thoracic'],['Cercles de hanches',30,'t','Debout, mains sur les hanches.','hipcircles'],['Pont fessier léger',30,'t','Lent, active les fessiers.','bridge']];
const C=[['Posture de l\'enfant',40,'t','Bras loin devant, respire profondément.','child'],['Cobra',30,'t','Hanches au sol, ouvre la poitrine.','cobra'],['Fessier allongé',40,'t','Ramène un genou vers l\'épaule opposée, 20 s par côté.','glute'],['Genoux contre la poitrine',40,'t','Allongé, serre les genoux contre toi, nuque relâchée.','kneechest']];
const ROTS={2:['full','haut'],3:['full','haut','mob'],4:['full','haut','bas','mob'],5:['full','haut','bas','mob','core'],6:['full','haut','bas','mob','core','full']};
const MIX={full:{push:2,pull:1,legs:2,core:2},haut:{push:3,pull:2,back:1,core:1},bas:{legs:5,core:2},core:{core:6,back:1},mob:{mob:8}};
const pool=g=>E[g].concat(S.band!==false?(E['b'+g]||[]):[],S.bar!==false?(E['r'+g]||[]):[]);
const barMix=m=>{if(S.bar!==false)return m;const o={...m};if(o.pull){o.back=(o.back||0)+o.pull;delete o.pull}return o};
const NAMES={full:'Corps entier',haut:'Haut du corps',bas:'Jambes et fessiers',core:'Gainage',mob:'Mobilité'};

const demo=n=>'https://www.youtube.com/results?search_query='+encodeURIComponent('exercice '+n.replace(/\s*\(.*?\)/,'')+' technique');
const sh=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
const mon=()=>{const d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()-((d.getDay()+6)%7));return d.getTime()};
const done=()=>S.log.filter(t=>t>=mon()).length;

function build(){
 const prog=Math.floor(S.log.length/S.n),f=ROTS[S.n][done()%S.n],m=barMix(MIX[f]);
 const val=(b,t)=>Math.round(b)+Math.min(prog,5)*(t=='t'?2:1);
 let ex=[];for(const g in m)ex.push(...sh(pool(g)).slice(0,m[g]).map(f=>f[S.lv]));
 ex=sh(ex).map(([n,b,t,c,f])=>({n,c,t,v:val(b,t),f}));
 const dur=s=>s.rest||s.t=='t'?s.v:s.v*3*(/chaque/.test(s.n)?2:1);
 const mk=(R,rec=f=='mob'?30:60)=>{
  const st=[{rest:1,n:'Prépare-toi',v:10,ph:'Échauffement'}];
  W.forEach(([n,v,t,c,f])=>st.push({ph:'Échauffement',n,c,t,v,f}));
  for(let r=1;r<=R;r++){
   const ph='Tour '+r+' sur '+R;
   ex.forEach((e,i)=>{st.push({ph,...e});if(i<ex.length-1)st.push({rest:1,n:'Repos',v:f=='mob'?10:20,ph})});
   if(r<R)st.push({rest:1,n:'Récupération',v:rec,ph});
  }
  C.forEach(([n,v,t,c,f])=>st.push({ph:'Étirements',n,c,t,v,f}));
  return st;
 };
 const tot=st=>st.reduce((a,s)=>a+dur(s),0);
 let R=3,st=mk(3);
 for(let r=4;r<=6;r++){const t=mk(r);if(tot(t)<=2340){R=r;st=t}else break}
 if(tot(st)<2100)st=mk(R,Math.min(120,(f=='mob'?30:60)+Math.ceil((2250-tot(st))/(R-1)/5)*5));
 return{f,ex,R,st,min:Math.round(tot(st)/60)};
}


const FIG={"pass":["f",[-90,90,90,0,0],[-90,90,90,-90,-90],[-90,90,90,-180,-180]],"row":["f",[-85,90,90,25,15],[-95,90,90,124,10]],"ohp":["f",[-90,90,90,70,-100],[-90,90,90,-90,-90]],"curl":["f",[-90,90,90,90,90],[-90,90,90,90,-30]],"hang":["b",[-90,90,90,-70,-70],[-88,92,95,-70,-70]],"pullup":["b",[-90,90,90,-70,-70],[-90,90,95,-2,-107],[-90,90,100,55,-80]],"scap":["b",[-90,90,90,-70,-70],[-90,90,90,-40,-100]],"hkr":["b",[-90,90,90,-70,-70],[-95,10,100,-70,-70]],"hlr":["b",[-90,90,90,-70,-70],[-95,5,5,-70,-70]],"lsit":["p",[-90,0,0,75,105],[-90,-6,-6,75,105]],"tuck":["p",[-90,-35,170,75,105],[-90,-45,165,75,105]],"vup":["p",[0,180,180,0,0],[-70,250,250,-120,-130]],"pu":["f",[-26,154,154,90,90],[-10,170,170,181,52]],"pike":["f",[41,110,110,41,41],[58,110,110,150,40]],"plank":["f",[-13,167,167,90,0],[-14,166,166,90,0]],"deadbug":["p",[0,-90,180,-90,-90,-90,180],[0,-90,180,0,0,180,180]],"bird":["p",[-20,90,180,90,90,90,180],[-20,90,180,0,0,180,180]],"legraise":["p",[0,180,180,180,180],[0,270,270,180,180]],"bicycle":["p",[-15,-60,-170,-90,60,-165,-165],[-15,-165,-165,-90,60,-60,-170]],"flutter":["p",[-20,190,190,185,185,205,205],[-20,205,205,185,185,190,190]],"hollow":["p",[-25,195,195,-15,-15],[-27,193,193,-15,-15]],"bridge":["f",[0,-120,120,180,180],[27,-158,94,180,180]],"bridge1":["f",[0,-120,120,180,180,-120,120],[27,-158,94,180,180,-158,-158]],"donkey":["p",[-20,90,180,90,90,90,180],[-20,180,270,90,90,90,180]],"sideleg":["p",[0,180,180,180,180,180,180],[0,180,180,180,180,215,215]],"squat":["f",[-90,90,90,0,0],[-60,10,100,0,0]],"sumo":["f",[-90,90,90,45,-45],[-78,5,100,45,-45]],"lunge":["f",[-90,90,90,30,-30,90,90],[-90,5,90,30,-30,100,175]],"superman":["p",[0,180,180,0,0],[-18,205,205,-20,-20]],"snowangel":["p",[-8,180,180,-10,-10],[-8,180,180,-165,-165]],"armcircles":["f",[-90,90,90,-90,-90],[-90,90,90,90,90]],"catcow":["p",[-8,90,180,90,90],[-30,90,180,90,90]],"thoracic":["p",[-20,90,180,90,90],[-30,90,180,-90,-90]],"hipcircles":["f",[-96,92,92,45,150],[-84,88,88,45,150]],"child":["p",[14,10,170,0,0],[8,10,170,0,0]],"cobra":["p",[-4,180,180,0,0],[-50,180,180,100,25]],"glute":["p",[0,-120,120,180,180],[0,-45,210,300,180]],"kneechest":["p",[0,-120,120,180,180],[0,-35,210,300,180]]};
let curFig=null,sFig=null;
const R_=Math.PI/180;
function pts(p){
 const d=(a,l)=>[Math.cos(a*R_)*l,Math.sin(a*R_)*l],ad=(a,b)=>[a[0]+b[0],a[1]+b[1]];
 const N=d(p[0],22),o={H:[0,0],N,Hd:ad(N,d(p[0],9)),K:d(p[1],16)};
 o.F=ad(o.K,d(p[2],16));o.E=ad(N,d(p[3],12));o.W=ad(o.E,d(p[4],12));
 if(p.length>5){o.K2=d(p[5],16);o.F2=ad(o.K2,d(p[6],16))}
 return o;
}
function drawFig(k,u,el){
 const [an,...K]=FIG[k],pa=pts(K[0]),xs=Object.values(pa).map(v=>v[0]),c=(Math.min(...xs)+Math.max(...xs))/2;
 const fi=u*(K.length-1),ki=Math.min(K.length-2,Math.floor(fi)),kw=fi-ki,q=pts(K[ki].map((v,j)=>v+(K[ki+1][j]-v)*kw));
 const hx=an=='b'?80-q.W[0]:80-c+(an=='f'?pa.F[0]-q.F[0]:0);
 const ym=Math.max(...Object.values(q).map(v=>v[1]),q.Hd[1]+5.5),dy=an=='b'?12-q.W[1]:68-ym;
 const P=v=>(v[0]+hx).toFixed(1)+' '+(v[1]+dy).toFixed(1);
 const L=(a,b,o,col)=>'<path d="M'+P(q[a])+'L'+P(q[b])+'" stroke="'+col+'" stroke-width="4" stroke-linecap="round" opacity="'+o+'"/>';
 let h=an=='b'?'<path d="M40 12H120" stroke="var(--ac)" stroke-width="3" stroke-linecap="round"/>':'<path d="M0 68H160" stroke="var(--bd)" stroke-width="1.5"/>';
 if(q.K2)h+=L('H','K2',.35,'var(--tx)')+L('K2','F2',.35,'var(--tx)');
 h+=L('H','N',1,'var(--tx)')+L('H','K',1,'var(--tx)')+L('K','F',1,'var(--tx)')+L('N','E',1,'var(--ac)')+L('E','W',1,'var(--ac)');
 h+='<circle cx="'+(q.Hd[0]+hx).toFixed(1)+'" cy="'+(q.Hd[1]+dy).toFixed(1)+'" r="5.5" fill="none" stroke="var(--tx)" stroke-width="3.5"/>';
 (el||$('#fig')).innerHTML=an=='b'?'<g transform="translate(80 12) scale(.78) translate(-80 -12)">'+h+'</g>':h;
}
const T0=performance.now();
(function loop(t){const u=(1-Math.cos((t-T0)/2400*2*Math.PI))/2;if(curFig)drawFig(curFig,u);if(sFig)drawFig(sFig,u,$('#sfig'));requestAnimationFrame(loop)})(T0);

let plan=null,P=null,tm=null,paused=false,left=0,AC=null;
function seg(sel,items,cur,cb){
 const el=$(sel);el.innerHTML='';
 items.forEach(([v,l])=>{const b=document.createElement('button');b.textContent=l;if(v===cur)b.className='on';b.onclick=()=>cb(v);el.appendChild(b)});
}
function show(id){['home','play','done','stats'].forEach(x=>$('#'+x).hidden=x!=id);$('#tabs').hidden=!(id=='home'||id=='stats');document.querySelectorAll('#tabs button').forEach(b=>b.className=b.dataset.t==id?'on':'')}
function home(){
 const d=done();
 $('#wkt').textContent=d+' sur '+S.n+' séances cette semaine, '+S.log.length+' au total';
 $('#wk').innerHTML=Array.from({length:S.n},(_,i)=>'<i class="'+(i<d?'on':'')+'"></i>').join('');
 seg('#segn',[2,3,4,5,6].map(v=>[v,String(v)]),S.n,v=>{S.n=v;save();plan=null;home()});
 seg('#segb',[[true,'Oui'],[false,'Non']],S.bar!==false,v=>{S.bar=v;save();plan=null;home()});
 seg('#segd',[[true,'Oui'],[false,'Non']],S.band!==false,v=>{S.band=v;save();plan=null;home()});
 seg('#segl',[[0,'Débutant'],[1,'Confirmé'],[2,'Avancé']],S.lv,v=>{S.lv=v;save();plan=null;home()});
 plan=plan||build();
 $('#pt').textContent=NAMES[plan.f]+', environ '+plan.min+' min, '+plan.R+' tours';
 $('#pl').innerHTML=plan.ex.map((e,i)=>'<div class="ex"><span><a href="#" data-i="'+i+'">'+e.n+'</a></span><span>'+e.v+(e.t=='t'?' s':' reps')+'</span></div>').join('');
 show('home');
}
function beep(f){try{AC=AC||new(window.AudioContext||window.webkitAudioContext)();const o=AC.createOscillator(),g=AC.createGain();o.frequency.value=f;g.gain.value=.15;o.connect(g);g.connect(AC.destination);o.start();o.stop(AC.currentTime+.12)}catch(e){}}
function paint(s){
 const timed=s.rest||s.t=='t';
 $('#big').innerHTML=timed?left+'<small>s</small>':s.v+'<small>reps</small>';
}
function step(){
 clearInterval(tm);paused=false;
 const s=P.st[P.i];if(!s)return fin();
 const timed=s.rest||s.t=='t';left=s.v;
 $('#ph').textContent=s.ph;$('#nm').textContent=s.n;
 $('#cue').textContent=s.c||(s.rest?'Respire, relâche les épaules.':'');
 const a=$('#demo');a.hidden=!!s.rest;a.href=demo(s.n);
 const nx=P.st.slice(P.i+1).find(x=>!x.rest);
 $('#nx').textContent=nx?'Ensuite : '+nx.n:'Dernier mouvement';
 $('#pb').style.width=(P.i/P.st.length*100)+'%';
 curFig=s.rest?null:s.f;$('#fig').style.display=curFig?'':'none';
 $('#ok').textContent=timed?'Pause':'Fait';
 $('#sk').textContent=s.rest?'Passer le repos':'Passer';
 paint(s);
 if(timed)tm=setInterval(()=>{
  if(paused)return;
  left--;
  if(left<=0){beep(990);return next()}
  if(left<=3)beep(660);
  paint(s);
 },1000);
}
function next(){P.i++;step()}
function fin(){
 clearInterval(tm);curFig=null;const now=Date.now();S.log.push(now);let reps=0,hold=0;
 P.st.forEach(x=>{if(!x.rest&&/^Tour/.test(x.ph)){if(x.t=='t')hold+=x.v;else reps+=x.v*(/chaque/.test(x.n)?2:1)}});
 (S.hist=S.hist||[]).push({t:now,f:plan.f,lv:S.lv,min:Math.max(1,Math.round((now-P.t0)/60000)),reps,hold});save();
 $('#dn').textContent=NAMES[plan.f]+', environ '+plan.min+' min. Bien joué.';
 plan=null;show('done');
}
$('#go').onclick=()=>{P={st:plan.st,i:0,t0:Date.now()};beep(1);try{navigator.wakeLock.request('screen')}catch(e){}show('play');step()};
$('#re').onclick=()=>{plan=null;home()};
$('#ok').onclick=()=>{const s=P.st[P.i];if(s.rest||s.t=='t'){paused=!paused;$('#ok').textContent=paused?'Reprendre':'Pause'}else next()};
$('#sk').onclick=next;
$('#demo').onclick=()=>{const s=P.st[P.i];if((s.rest||s.t=='t')&&!paused){paused=true;$('#ok').textContent='Reprendre'}};
$('#quit').onclick=()=>{clearInterval(tm);curFig=null;home()};
$('#back').onclick=home;
function openSheet(e){sFig=e.f;$('#sn').textContent=e.n;$('#sc2').textContent=e.c||'';$('#sl').href=demo(e.n);$('#sheet').hidden=false}
function closeSheet(){sFig=null;$('#sheet').hidden=true}
$('#sx').onclick=closeSheet;
$('#sheet').onclick=ev=>{if(ev.target.id=='sheet')closeSheet()};
$('#pl').onclick=ev=>{const a=ev.target.closest('a');if(!a)return;ev.preventDefault();openSheet(plan.ex[+a.dataset.i])};
function stats(){
 const L=S.log,H=S.hist||[],wk=mon(),WK=6048e5,fd=t=>new Date(t).toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit'});
 const ws=Array.from({length:8},(_,i)=>wk-(7-i)*WK),pw=ws.map(a=>L.filter(t=>t>=a&&t<a+WK).length);
 let st=0,i=6;if(pw[7]>=S.n)st=1;while(i>=0&&pw[i]>=S.n){st++;i--}
 const mins=H.reduce((a,h)=>a+h.min,0);
 $('#sts').textContent=L.length?'Objectif : '+S.n+' séances par semaine.':'Fais ta première séance pour voir ta progression.';
 $('#kpi').innerHTML=[[L.length,'séances au total'],[pw[7]+' / '+S.n,'cette semaine'],[mins>=60?Math.floor(mins/60)+' h '+String(mins%60).padStart(2,'0'):mins+' min','temps d\'entraînement'],[st,'semaines d\'affilée à l\'objectif']].map(([b,l])=>'<div><b>'+b+'</b><span>'+l+'</span></div>').join('');
 const bars=(a,id)=>{const mx=Math.max(1,...a.map(x=>x[0]));$(id).innerHTML=a.map(([v,l])=>'<div><span>'+v+'</span><i style="height:'+Math.round(v/mx*80)+'px"></i><span>'+l+'</span></div>').join('')};
 bars(pw.map((v,i)=>[v,fd(ws[i])]),'#bw');
 const lv=H.slice(-10);
 if(lv.length)bars(lv.map(h=>[h.reps,fd(h.t)]),'#bv');else $('#bv').innerHTML='<span style="color:var(--mut)">Pas encore de séance enregistrée.</span>';
 $('#hl').innerHTML=H.slice(-8).reverse().map(h=>'<div class="hr"><span>'+fd(h.t)+', '+NAMES[h.f]+' ('+['Débutant','Confirmé','Avancé'][h.lv]+')</span><span>'+h.min+' min, '+h.reps+' reps</span></div>').join('')||'<span style="color:var(--mut)">Rien pour l\'instant.</span>';
 show('stats');
}
document.querySelectorAll('#tabs button').forEach(b=>b.onclick=()=>b.dataset.t=='stats'?stats():home());
home();
</script></body></html>
