[['Pompes mains larges',8,'r','Mains plus larges que les épaules.','pu'],['Pompes diamant',8,'r','Mains rapprochées sous la poitrine.','pu'],['Pompes pseudo planche',6,'r','Mains près des hanches, épaules en avant des mains.','pu']],
[['Pike hold',20,'t','Hanches hautes, bras tendus, tête entre les bras.','pike'],['Pike push-ups',8,'r','Hanches hautes, tête vers le sol entre les mains.','pike'],['Pike push-ups lents (3 s)',6,'r','Descends en 3 s, tête entre les mains.','pike']]],
core:[
[['Planche sur les genoux',20,'t','Genoux au sol, corps aligné, fessiers serrés.','plank'],['Planche',30,'t','Tête-talons alignés, fessiers serrés.','plank'],['Planche sur les mains',30,'t','Bras tendus, épaules au-dessus des poignets.','plank']],
[['Planche latérale sur les genoux (chaque côté)',15,'t','Genoux pliés, hanches hautes. Change de côté à la moitié.','plank'],['Planche latérale (chaque côté)',20,'t','Hanches hautes. Change de côté à la moitié.','plank'],['Planche latérale, hanche qui monte (chaque côté)',20,'t','Descends et remonte la hanche en continu.','plank']],
[['Hollow hold, genoux fléchis',20,'t','Genoux pliés, bas du dos collé au sol.','hollow'],['Hollow hold',25,'t','Bas du dos collé au sol.','hollow'],['Hollow rocks',15,'r','Balance en gardant la position creuse.','hollow']],
[['Assis tuck, mains au sol',15,'t','Pousse sur les mains, décolle les fesses.','tuck'],['L-sit tuck',20,'t','Genoux serrés, pousse fort dans le sol.','tuck'],['L-sit',15,'t','Jambes tendues, fesses décollées.','lsit']],
[['Relevés de genoux allongé',10,'r','Dos plaqué, genoux vers la poitrine.','legraise'],['Relevés de jambes',12,'r','Dos plaqué, descente contrôlée.','legraise'],['V-ups',10,'r','Mains vers les pieds, jambes tendues.','vup']],
[['Dead bug',10,'r','Dos plaqué au sol, bras et jambe opposés.','deadbug'],['Dead bug lent',12,'r','Jambe tendue au ras du sol, très lent.','deadbug'],['Flutter kicks',30,'t','Petits battements, jambes basses.','flutter']]],
legs:[
[['Squats',15,'r','Pieds largeur d\'épaules, assis en arrière, talons au sol.','squat'],['Squats tempo (3 s)',12,'r','Descends en 3 s, remonte vite.','squat'],['Pistol squat, descente lente (chaque jambe)',5,'r','Descends sur une jambe en 4 s, remonte à deux jambes.','squat']],
[['Squat sumo',15,'r','Pieds écartés, pointes vers l\'extérieur, descends bien droit.','sumo'],['Squat sumo tempo (3 s)',12,'r','Descends en 3 s, reste droit.','sumo'],['Squat sumo, pause 3 s en bas',10,'r','Tiens 3 s en bas, genoux ouverts.','sumo']],
[['Fentes arrière (chaque jambe)',10,'r','Grand pas en arrière, genou avant au-dessus de la cheville.','lunge'],['Fentes arrière tempo (chaque jambe)',10,'r','Descends en 3 s.','lunge'],['Fentes arrière, pause 3 s (chaque jambe)',8,'r','Tiens 3 s en bas.','lunge']],
[['Pont fessier',15,'r','Pousse avec les talons, serre en haut.','bridge'],['Pont unijambiste (chaque jambe)',8,'r','Bassin à plat, une jambe tendue.','bridge1'],['Pont unijambiste lent (chaque jambe)',10,'r','Montée 1 s, descente 3 s.','bridge1']],
[['Donkey kicks (chaque jambe)',12,'r','À quatre pattes, talon vers le plafond.','donkey'],['Abduction couchée (chaque jambe)',12,'r','Sur le côté, jambe haute tendue.','sideleg'],['Abduction couchée, pause 3 s (chaque jambe)',10,'r','Tiens 3 s en haut.','sideleg']]],
